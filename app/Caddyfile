# Serves the built SPA. Railway injects $PORT at runtime; 8080 is the local
# fallback so `docker run` works without one.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Client-side routing: react-router owns every path, so anything that
	# isn't a real file still has to return a document rather than a bare 404 —
	# otherwise a deep link or a refresh on any route but / breaks.
	#
	# {path}/index.html is the important middle candidate: it serves the
	# per-route shells written by scripts/prerender.mjs, each with its own
	# title, description and canonical. Without it every URL falls through to
	# one document and the whole site shares the home page's metadata.
	#
	# The last candidate is 404.html, not index.html. Every real route has a
	# shell, so this only fires for a path that does not exist — and answering
	# those with the home page told crawlers that every mistyped URL was a
	# duplicate of the home page, carrying its canonical. 404.html is the same
	# SPA shell marked noindex.
	try_files {path} {path}/index.html /404.html
	file_server

	# Vite content-hashes everything under /assets, so those filenames change
	# whenever the bytes do and can be cached hard. Every other response keeps
	# its name across deploys and must always revalidate — otherwise a browser
	# serves last deploy's HTML, pointing at asset filenames that no longer
	# exist. Same reasoning as the root main.go.
	#
	# This has to be a negated matcher rather than `header /index.html`: that
	# matched one exact path, so the per-route shells (/about/index.html and
	# friends) and 404.html went out with no cache directive at all.
	@assets path /assets/*
	@revalidate not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @revalidate Cache-Control "no-cache, must-revalidate"
}
