# Serves the built SPA. Railway injects $PORT at runtime; 8080 is the local
# fallback so `docker run` works without one.
:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Client-side routing: react-router owns every path, so anything that
	# isn't a real file has to return index.html rather than a 404. Without
	# this, a deep link or a refresh on any route but / breaks.
	try_files {path} /index.html
	file_server

	# Vite content-hashes everything under /assets, so those filenames change
	# whenever the bytes do and can be cached hard. index.html is the one file
	# that keeps its name across deploys, so it must always revalidate —
	# otherwise a browser serves last deploy's HTML, pointing at asset
	# filenames that no longer exist. Same reasoning as the root main.go.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache, must-revalidate"
}
